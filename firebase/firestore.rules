rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isPrivilegedUser() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
      );
    }
    match /pending_notifications/{docId} {
      allow read, write: if isSignedIn();
    }
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isPrivilegedUser());
      match /notes/{noteId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
    match /prayers/{prayerId} {
      allow read, write: if isSignedIn();
    }
    match /songs/{songId} {
      allow read, write: if isSignedIn();
    }
    match /kamus_global/{wordId} {
      allow read, write: if isSignedIn();
    }
    match /keuangan_daerah/{docId} {
      allow read, write: if isSignedIn();
    }
    match /perpuluhan_daerah/{docId} {
      allow read, write: if isSignedIn();
    }
    match /chats_daerah/{daerahId} {
      allow read, write: if isSignedIn();
      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
    }
    match /info_surat_daerah/{docId} {
      allow read, write: if isSignedIn();
    }
    match /aset_gereja/{docId} {
      allow read: if isSignedIn();
      allow write: if isPrivilegedUser();
    }
    match /churches/{churchId} {
      allow read, write: if isSignedIn();
      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
      match /aset/{asetId} {
        allow read: if isSignedIn();
        allow write: if isPrivilegedUser();
      }
      match /chats/{chatId} {
        allow read, write: if isSignedIn();
        allow delete: if isPrivilegedUser();
      }
      match /jemaat/{jemaatId} {
        allow read: if isSignedIn();
        allow write: if isPrivilegedUser();
      }
    }
    match /{path=**}/jemaat/{document} {
      allow read: if isSignedIn();
    }

    // Tambahan khusus Pengurus Daerah; aturan sebelumnya dipertahankan.
    function pdAccountActive() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('isBlocked', false) != true;
    }
    
    function pdSuper() {
      return pdAccountActive()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('role', '') == 'superadmin';
    }

    function pdOwn(area) {
      return pdAccountActive() && area is string && area != ''
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('adminDaerahArea', '') == area;
    }

    function pdParentOwned(idDaerah) {
      return exists(/databases/$(database)/documents/struktur_pengurus_daerah/$(idDaerah))
        && pdOwn(get(/databases/$(database)/documents/struktur_pengurus_daerah/$(idDaerah)).data.daerah);
    }

    match /struktur_pengurus_daerah/{idDaerah} {
      // Superadmin dapat membuka daerah baru tanpa daftar nama dalam Rules.
      allow get: if pdSuper() || pdParentOwned(idDaerah);
      // Dokumen induk daerah baru dibuat superadmin melalui pengisian pengurus.
      allow create: if pdSuper()
        && request.resource.data.daerah is string
        && request.resource.data.daerah.size() > 0;
      allow update: if (pdSuper() || pdOwn(resource.data.daerah))
        && request.resource.data.daerah == resource.data.daerah;
      // Tidak menghapus induk atau memindahkan daerah beserta subkoleksinya.

      match /{bagian}/{anggotaId} {
        allow read: if bagian in ['penasehat', 'mkdp', 'bpk', 'komisi']
          && (pdSuper() || pdParentOwned(idDaerah));
        allow create, update: if bagian in ['penasehat', 'mkdp', 'bpk', 'komisi']
          && (pdSuper() || pdParentOwned(idDaerah))
          && request.resource.data.daerah ==
            getAfter(/databases/$(database)/documents/struktur_pengurus_daerah/$(idDaerah)).data.daerah;
        allow delete: if bagian in ['penasehat', 'mkdp', 'bpk', 'komisi']
          && (pdSuper() || pdParentOwned(idDaerah));
      }
    }
  }
}
