rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isPrivilegedUser() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin'
      );
    }
    match /pending_notifications/{docId} {
      allow read, write: if isSignedIn();
    }
    match /users/{userId} {
      allow read: if isSignedIn();
      // A linked pastor must not grant themselves regional editing privileges.
      allow create: if isSignedIn() && (isPrivilegedUser() ||
        (request.auth.uid == userId && request.resource.data.get('role', 'user') == 'user'
          && request.resource.data.get('adminDaerahArea', '') == ''
          && request.resource.data.get('isBlocked', false) == false));
      allow update: if isSignedIn() && (isPrivilegedUser() ||
        (request.auth.uid == userId && !request.resource.data.diff(resource.data)
          .affectedKeys().hasAny(['role', 'adminDaerahArea', 'isBlocked'])));
      allow delete: if isSignedIn() && (request.auth.uid == userId || isPrivilegedUser());
      match /notes/{noteId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }
    }
    match /prayers/{prayerId} {
      allow read, write: if isSignedIn();
    }
    match /songs/{songId} {
      allow read, write: if isSignedIn();
    }
    match /kamus_global/{wordId} {
      allow read, write: if isSignedIn();
    }
    match /chats_daerah/{daerahId} {
      allow read, write: if isSignedIn();
      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
    }
    match /aset_gereja/{docId} {
      allow read: if isSignedIn();
      allow write: if isPrivilegedUser();
    }
    match /churches/{churchId} {
      allow read, write: if isSignedIn();
      match /{allPaths=**} {
        allow read, write: if isSignedIn();
      }
      match /aset/{asetId} {
        allow read: if isSignedIn();
        allow write: if isPrivilegedUser();
      }
      match /chats/{chatId} {
        allow read, write: if isSignedIn();
        allow delete: if isPrivilegedUser();
      }
      match /jemaat/{jemaatId} {
        allow read: if isSignedIn();
        allow write: if isPrivilegedUser();
      }
    }
    match /{path=**}/jemaat/{document} {
      allow read: if isSignedIn();
    }

    // Tambahan khusus Pengurus Daerah; aturan sebelumnya dipertahankan.
    function pdAccountActive() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.get('isBlocked', false) != true;
    }
    
    function pdSuper() {
      return pdAccountActive()
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('role', '') == 'superadmin';
    }

    function pdOwn(area) {
      return pdAccountActive() && area is string && area != ''
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
          .data.get('adminDaerahArea', '') == area;
    }

    function pdLinkedPastor(area) {
      let account = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      let churchId = account.get('churchId', '');
      let memberId = account.get('jemaatId', '');
      return pdAccountActive() && account.get('role', '') == 'gembala'
        && churchId is string && churchId != ''
        && memberId is string && memberId != ''
        && exists(/databases/$(database)/documents/churches/$(churchId))
        && exists(/databases/$(database)/documents/churches/$(churchId)/jemaat/$(memberId))
        && get(/databases/$(database)/documents/churches/$(churchId)/jemaat/$(memberId)).data.get('uid', '') == request.auth.uid
        && get(/databases/$(database)/documents/churches/$(churchId)).data.get('daerah', '') == area;
    }

    function pdRead(area) {
      return pdSuper() || pdOwn(area) || (request.auth != null && pdLinkedPastor(area));
    }

    function pdParentReadable(idDaerah) {
      return exists(/databases/$(database)/documents/struktur_pengurus_daerah/$(idDaerah))
        && pdRead(get(/databases/$(database)/documents/struktur_pengurus_daerah/$(idDaerah)).data.daerah);
    }

    function pdParentOwned(idDaerah) {
      return exists(/databases/$(database)/documents/struktur_pengurus_daerah/$(idDaerah))
        && pdOwn(get(/databases/$(database)/documents/struktur_pengurus_daerah/$(idDaerah)).data.daerah);
    }

    // Inventaris dan daftar pengurus daerah format lama memakai koleksi datar.
    match /{koleksi}/{recordId} {
      allow get: if koleksi in ['inventaris_daerah', 'pengurus_daerah', 'keuangan_daerah', 'perpuluhan_daerah', 'info_surat_daerah']
        && (pdSuper() || pdRead(resource.data.daerah)
          || (!exists(/databases/$(database)/documents/$(koleksi)/$(recordId))
            && pdAccountActive()
            && get(/databases/$(database)/documents/users/$(request.auth.uid))
              .data.get('adminDaerahArea', '') != ''));
      allow list: if koleksi in ['inventaris_daerah', 'pengurus_daerah', 'keuangan_daerah', 'perpuluhan_daerah', 'info_surat_daerah']
        && pdRead(resource.data.daerah);
      allow create: if koleksi in ['inventaris_daerah', 'pengurus_daerah', 'keuangan_daerah', 'perpuluhan_daerah', 'info_surat_daerah']
        && request.resource.data.daerah is string
        && request.resource.data.daerah.size() > 0
        && (pdSuper() || pdOwn(request.resource.data.daerah));
      allow update: if koleksi in ['inventaris_daerah', 'pengurus_daerah', 'keuangan_daerah', 'perpuluhan_daerah', 'info_surat_daerah']
        && (pdSuper() || pdOwn(resource.data.daerah))
        && request.resource.data.daerah == resource.data.daerah;
      allow delete: if koleksi in ['inventaris_daerah', 'pengurus_daerah', 'keuangan_daerah', 'perpuluhan_daerah', 'info_surat_daerah']
        && (pdSuper() || pdOwn(resource.data.daerah));
    }

    match /info_surat_daerah/{postId}/komentar/{commentId} {
      function postArea() {
        return get(/databases/$(database)/documents/info_surat_daerah/$(postId)).data.daerah;
      }
      function discussionAccess() {
        return exists(/databases/$(database)/documents/info_surat_daerah/$(postId))
          && pdRead(postArea());
      }
      allow read: if discussionAccess();
      allow create: if discussionAccess()
        && request.resource.data.keys().hasAll(['authorId', 'authorName', 'text', 'createdAt'])
        && request.resource.data.keys().hasOnly(['authorId', 'authorName', 'text', 'createdAt'])
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.authorName is string
        && request.resource.data.authorName.size() > 0
        && request.resource.data.authorName.size() <= 200
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt == request.time;
      // Pesan tidak diedit; penulis atau admin dapat menghapusnya.
      allow delete: if discussionAccess()
        && (resource.data.authorId == request.auth.uid || pdSuper() || pdOwn(postArea()));
    }

    match /struktur_pengurus_daerah/{idDaerah} {
      // Superadmin dapat membuka daerah baru tanpa daftar nama dalam Rules.
      allow get: if pdSuper() || pdParentReadable(idDaerah);
      // Dokumen induk daerah baru dibuat superadmin melalui pengisian pengurus.
      allow create: if pdSuper()
        && request.resource.data.daerah is string
        && request.resource.data.daerah.size() > 0;
      allow update: if (pdSuper() || pdOwn(resource.data.daerah))
        && request.resource.data.daerah == resource.data.daerah;
      // Tidak menghapus induk atau memindahkan daerah beserta subkoleksinya.

      match /{bagian}/{anggotaId} {
        allow read: if bagian in ['penasehat', 'mkdp', 'bpk', 'komisi']
          && (pdSuper() || pdParentReadable(idDaerah));
        allow create, update: if bagian in ['penasehat', 'mkdp', 'bpk', 'komisi']
          && (pdSuper() || pdParentOwned(idDaerah))
          && request.resource.data.daerah ==
            getAfter(/databases/$(database)/documents/struktur_pengurus_daerah/$(idDaerah)).data.daerah;
        allow delete: if bagian in ['penasehat', 'mkdp', 'bpk', 'komisi']
          && (pdSuper() || pdParentOwned(idDaerah));
      }
    }
  }
}
