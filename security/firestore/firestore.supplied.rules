rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isPrivilegedUser() {
      return isSignedIn() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'superadmin');
    }
    match /pending_notifications/{docId} { allow read, write: if isSignedIn(); }
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isPrivilegedUser());
      match /notes/{noteId} { allow read, write: if isSignedIn() && request.auth.uid == userId; }
    }
    match /prayers/{prayerId} { allow read, write: if isSignedIn(); }
    match /songs/{songId} { allow read, write: if isSignedIn(); }
    match /kamus_global/{wordId} { allow read, write: if isSignedIn(); }
    match /keuangan_daerah/{docId} { allow read, write: if isSignedIn(); }
    match /perpuluhan_daerah/{docId} { allow read, write: if isSignedIn(); }
    match /chats_daerah/{daerahId} {
      allow read, write: if isSignedIn();
      match /{allPaths=**} { allow read, write: if isSignedIn(); }
    }
    match /info_surat_daerah/{docId} { allow read, write: if isSignedIn(); }
    match /aset_gereja/{docId} {
      allow read: if isSignedIn();
      allow write: if isPrivilegedUser();
    }
    match /churches/{churchId} {
      allow read, write: if isSignedIn();
      match /{allPaths=**} { allow read, write: if isSignedIn(); }
      match /aset/{asetId} {
        allow read: if isSignedIn();
        allow write: if isPrivilegedUser();
      }
      match /chats/{chatId} {
        allow read, write: if isSignedIn();
        allow delete: if isPrivilegedUser();
      }
      match /jemaat/{jemaatId} {
        allow read: if isSignedIn();
        allow write: if isPrivilegedUser();
      }
    }
    match /{path=**}/jemaat/{document} { allow read: if isSignedIn(); }
  }
}
